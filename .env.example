APP_ENV=development
DATABASE_URL=sqlite:///./storage/titleguard.db
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_PATH=./storage/faiss/title_index.faiss
FAISS_ID_MAP_PATH=./storage/faiss/id_map.json
FAISS_METADATA_PATH=./storage/faiss/index_metadata.json
FAISS_TOP_K=20
CLUSTER_METADATA_PATH=./storage/clusters/cluster_metadata.json
CLUSTER_TOP_N=3
SEMANTIC_WEIGHT=0.50
LEXICAL_WEIGHT=0.30
PHONETIC_WEIGHT=0.20
SCORE_THRESHOLD_CONFLICT=0.75
SCORE_THRESHOLD_REVIEW=0.50
ADMIN_API_KEY=replace-with-secure-value
CORS_ORIGINS=http://localhost:8000,http://localhost:3000
